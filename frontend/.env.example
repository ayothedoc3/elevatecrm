# Elevate CRM Frontend (.env.example)
#
# Copy to `.env` and adjust as needed.
# Note: `.env` is gitignored in this repo.

# Backend API URL
REACT_APP_BACKEND_URL=http://localhost:8001
REACT_APP_API_URL=http://localhost:8001

# UI feature gating:
# - `1` = Phase 1 core (Leads/Pipeline/Reports)
# - `2+` = show additional modules (requires backend support)
REACT_APP_APP_PHASE=2

# Application
REACT_APP_NAME=Elevate CRM
