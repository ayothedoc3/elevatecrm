# Elevate CRM Backend (.env.example)
#
# Copy to `.env` and fill in real values.
# Note: `.env` is gitignored in this repo.

# -----------------------------
# Database (Phase 1 core = Postgres)
# -----------------------------
# Example: postgresql://crm_user:crm_password@localhost:5432/crm_os
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_os

# -----------------------------
# Legacy MongoDB (only if running `server_mongo.py`)
# -----------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=elevate_crm

# -----------------------------
# Security
# -----------------------------
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------
# CORS
# -----------------------------
# Comma-separated list, or * for local dev.
# Example: http://localhost:3000
CORS_ORIGINS=*

# -----------------------------
# Optional AI keys (only needed for AI features)
# -----------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# -----------------------------
# Optional messaging/webhook defaults (provider credentials are stored in Settings)
# -----------------------------
# Public backend base URL used for provider webhook callbacks (Twilio/SendGrid)
WEBHOOK_BASE_URL=
# Optional fallback sender values if not set in integration config
SENDGRID_FROM_EMAIL=
TWILIO_FROM_NUMBER=

# -----------------------------
# Server
# -----------------------------
HOST=0.0.0.0
PORT=8001

